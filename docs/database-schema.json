{
  "database": {
    "engine": "sqlite",
    "filename": "data/pm.sqlite3",
    "foreign_keys": true,
    "journal_mode": "WAL"
  },
  "tables": {
    "users": {
      "purpose": "Application user accounts.",
      "columns": {
        "id": {
          "type": "TEXT",
          "nullable": false,
          "primary_key": true
        },
        "username": {
          "type": "TEXT",
          "nullable": false,
          "unique": true
        },
        "password_hash": {
          "type": "TEXT",
          "nullable": false,
          "format": "salted PBKDF2-HMAC-SHA256, stored as 'salt$hex-digest'"
        },
        "created_at": {
          "type": "TEXT",
          "nullable": false,
          "format": "ISO-8601 UTC timestamp"
        }
      }
    },
    "sessions": {
      "purpose": "Opaque bearer tokens issued at login/register, validated on every authenticated request.",
      "columns": {
        "token": {
          "type": "TEXT",
          "nullable": false,
          "primary_key": true
        },
        "user_id": {
          "type": "TEXT",
          "nullable": false,
          "references": "users.id",
          "on_delete": "CASCADE"
        },
        "created_at": {
          "type": "TEXT",
          "nullable": false,
          "format": "ISO-8601 UTC timestamp"
        },
        "expires_at": {
          "type": "TEXT",
          "nullable": false,
          "format": "ISO-8601 UTC timestamp, 30 days from creation"
        }
      }
    },
    "boards": {
      "purpose": "A user may own any number of Kanban boards.",
      "columns": {
        "id": {
          "type": "TEXT",
          "nullable": false,
          "primary_key": true
        },
        "user_id": {
          "type": "TEXT",
          "nullable": false,
          "references": "users.id",
          "on_delete": "CASCADE"
        },
        "title": {
          "type": "TEXT",
          "nullable": false
        },
        "created_at": {
          "type": "TEXT",
          "nullable": false,
          "format": "ISO-8601 UTC timestamp"
        },
        "updated_at": {
          "type": "TEXT",
          "nullable": false,
          "format": "ISO-8601 UTC timestamp"
        }
      }
    },
    "columns": {
      "purpose": "Ordered board stages whose titles can be renamed.",
      "columns": {
        "id": {
          "type": "TEXT",
          "nullable": false,
          "primary_key": true
        },
        "board_id": {
          "type": "TEXT",
          "nullable": false,
          "references": "boards.id",
          "on_delete": "CASCADE"
        },
        "title": {
          "type": "TEXT",
          "nullable": false
        },
        "position": {
          "type": "INTEGER",
          "nullable": false,
          "minimum": 0
        }
      },
      "constraints": [
        "UNIQUE(board_id, position)"
      ]
    },
    "cards": {
      "purpose": "Cards contained by a board column and ordered within that column.",
      "columns": {
        "id": {
          "type": "TEXT",
          "nullable": false,
          "primary_key": true
        },
        "column_id": {
          "type": "TEXT",
          "nullable": false,
          "references": "columns.id",
          "on_delete": "CASCADE"
        },
        "title": {
          "type": "TEXT",
          "nullable": false
        },
        "details": {
          "type": "TEXT",
          "nullable": false,
          "default": ""
        },
        "priority": {
          "type": "TEXT",
          "nullable": true,
          "enum": ["low", "medium", "high"]
        },
        "due_date": {
          "type": "TEXT",
          "nullable": true,
          "format": "YYYY-MM-DD calendar date",
          "wire_name": "dueDate"
        },
        "labels": {
          "type": "TEXT",
          "nullable": false,
          "default": "[]",
          "format": "JSON array of trimmed, de-duplicated tag strings (max 10, each <= 32 chars)"
        },
        "position": {
          "type": "INTEGER",
          "nullable": false,
          "minimum": 0
        },
        "created_at": {
          "type": "TEXT",
          "nullable": false,
          "format": "ISO-8601 UTC timestamp"
        },
        "updated_at": {
          "type": "TEXT",
          "nullable": false,
          "format": "ISO-8601 UTC timestamp"
        }
      },
      "constraints": [
        "UNIQUE(column_id, position)"
      ]
    },
    "comments": {
      "purpose": "User-authored comment threads attached to a card. card_id is a plain column, not a foreign key, because a full-board replace deletes and reinserts every card row.",
      "columns": {
        "id": {"type": "TEXT", "nullable": false, "primary_key": true},
        "board_id": {"type": "TEXT", "nullable": false, "references": "boards.id", "on_delete": "CASCADE"},
        "card_id": {"type": "TEXT", "nullable": false},
        "user_id": {"type": "TEXT", "nullable": false, "references": "users.id", "on_delete": "CASCADE"},
        "author": {"type": "TEXT", "nullable": false, "note": "username snapshot at creation time"},
        "body": {"type": "TEXT", "nullable": false, "note": "1..2000 characters"},
        "created_at": {"type": "TEXT", "nullable": false, "format": "ISO-8601 UTC timestamp"}
      }
    },
    "activity": {
      "purpose": "Append-only board activity feed. Card change entries are derived by diffing the board before and after each PUT; comment entries are written when a comment is added or deleted.",
      "columns": {
        "id": {"type": "TEXT", "nullable": false, "primary_key": true},
        "board_id": {"type": "TEXT", "nullable": false, "references": "boards.id", "on_delete": "CASCADE"},
        "card_id": {"type": "TEXT", "nullable": true, "note": "null for board-level entries such as column_renamed"},
        "kind": {"type": "TEXT", "nullable": false, "enum": ["card_created", "card_edited", "card_moved", "card_deleted", "column_renamed", "comment_added", "comment_deleted"]},
        "summary": {"type": "TEXT", "nullable": false, "note": "human-readable one-line description"},
        "created_at": {"type": "TEXT", "nullable": false, "format": "ISO-8601 UTC timestamp"}
      }
    }
  },
  "relationships": [
    "users 1-to-many sessions",
    "users 1-to-many boards",
    "boards 1-to-many columns",
    "columns 1-to-many cards",
    "boards 1-to-many comments",
    "boards 1-to-many activity"
  ],
  "board_payload": {
    "columns": [
      {
        "id": "column-id",
        "title": "Column title",
        "cardIds": [
          "card-id"
        ]
      }
    ],
    "cards": {
      "card-id": {
        "id": "card-id",
        "title": "Card title",
        "details": "Card details",
        "priority": "high",
        "dueDate": "2026-01-31",
        "labels": ["research", "q1"]
      }
    }
  },
  "board_payload_notes": [
    "priority is one of low, medium, high, or null.",
    "dueDate is a YYYY-MM-DD calendar date or null.",
    "labels is an array of tag strings, trimmed and de-duplicated (max 10, each <= 32 chars); it may be empty.",
    "All three card metadata fields are always present in API responses."
  ],
  "board_summary_payload": {
    "id": "board-id",
    "title": "Board title",
    "updatedAt": "ISO-8601 UTC timestamp"
  },
  "comment_payload": {
    "id": "comment-id",
    "cardId": "card-id",
    "author": "username",
    "body": "Comment text",
    "createdAt": "ISO-8601 UTC timestamp"
  },
  "activity_payload": {
    "id": "activity-id",
    "kind": "card_moved",
    "summary": "Moved \"Card\" from Backlog to Done",
    "cardId": "card-id or null",
    "createdAt": "ISO-8601 UTC timestamp"
  },
  "invariants": [
    "Every session belongs to exactly one user and is deleted on logout or expiry.",
    "Every board belongs to exactly one user; a user may own any number of boards.",
    "A user must always own at least one board; the last board cannot be deleted.",
    "Every column belongs to exactly one board.",
    "Every card belongs to exactly one column.",
    "Positions are zero-based and unique within their parent.",
    "The API returns columns ordered by position and cards ordered by position.",
    "Board mutations update updated_at and are committed atomically.",
    "A board's column set is fixed after creation; columns may be renamed but not added, removed, or re-identified.",
    "A full-board replace preserves each card's created_at, matched by card id.",
    "A full-board replace appends one activity row per detected change and deletes the comments of any card removed by that replace.",
    "Comments and activity are read and written through dedicated /api/boards/{id} sub-resource routes, not the board content payload.",
    "Only a comment's author can delete it."
  ],
  "mvp_seed": {
    "username": "user",
    "password": "password",
    "board": "Create the five demo columns and existing demo cards for the seeded 'user' account when no board exists."
  }
}
